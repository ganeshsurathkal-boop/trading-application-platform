# ─────────────────────────────────────────────────────────────
# TICKR — Environment Configuration (EXAMPLE)
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Database ─────────────────────────────────────────────────
# SQLite (default for development)
DATABASE_URL=sqlite:///./tickr.db
# PostgreSQL (uncomment for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/tickr

# ── Zerodha Kite Connect ──────────────────────────────────────
# Step 1: Create an app at https://developers.kite.trade/
#         Set the redirect URL to: https://localhost:5173  (frontend dev server runs on HTTPS)
# Step 2: Copy your API Key and API Secret below.
# Step 3: Start the app → go to Profile → Data Sources → Connect to Zerodha Kite
#         The app will fill KITE_ACCESS_TOKEN automatically after you log in.
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here
KITE_ACCESS_TOKEN=

# How many years of EOD history to pull during the one-time bulk download
KITE_BULK_DOWNLOAD_YEARS=5

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=https://localhost:5173,http://localhost:5173,http://localhost:3000
